{
  "name": "techrun-photos-functions",
  "private": true,
  "description": "TechRun 2027 race photos: upload pipeline, bib recognition, GCash orders.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.dev.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage,auth"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
